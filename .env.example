# Live setup: copy this file to .env.local for Node or .env for Docker Compose.
# Fill all required credentials before starting.
# Node: npm start
# Traefik: docker compose -f docker-compose.traefik.yml up -d --build
# With .env.local, add --env-file .env.local before -f.
# Import your inventory in the selected mode; see README.md for commands.

# local uses Mailpit; live uses Kirim.Email and requires HTTPS + real Turnstile keys.
APP_MODE=live
# Traefik hostname only (no scheme, port or path); configure it in DNS and Turnstile.
APP_HOST=dana.skytek.id
# Node/local Compose origin. Traefik Compose derives https://APP_HOST automatically.
# Exact HTTPS browser origin, without a path or trailing slash.
PUBLIC_ORIGIN=https://dana.skytek.id
# Traefik only: comma-separated proxy IPs/CIDRs; prefer exact /32 or /128 addresses.
# Example only: TRUSTED_PROXY_CIDRS=172.18.0.2/32 (use your actual Traefik address).
# Do not trust a shared network containing other services. Empty means no proxy trust.
# The Traefik Compose file requires this setting; direct/local use may leave it empty.
TRUSTED_PROXY_CIDRS=
# Live report pages/APIs are disabled unless both values are set. Uses HTTP Basic auth.
# Generate REPORTS_PASSWORD with openssl rand -hex 32; minimum 32 characters.
# Local mode permits reports without these credentials on the configured local host.
REPORTS_USER=
REPORTS_PASSWORD=
# Required in live mode: production keys from the same Cloudflare Turnstile widget.
# Allow dana.skytek.id (or your selected APP_HOST) on that widget.
# The app sets action=request_code and checks that action and hostname server-side.
# Public site key goes to the browser; the Siteverify secret stays on the server.
# Cloudflare test keys are rejected in live mode.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local mode generates a private secret when empty. Required in live mode.
# Generate a random value: openssl rand -hex 32
# Preserve this stable secret with database backups; changing it breaks hashes.
CLAIM_SECRET=
# Required in live mode. Use the domain configured in Kirim.Email.
KIRIM_EMAIL_DOMAIN=skytek.id
# Server-only credentials: auth.username and auth.password from the API example.
# Enter the full credentials in your private env file, not the masked examples.
KIRIM_EMAIL_USERNAME=
KIRIM_EMAIL_PASSWORD=
# Your sender address on that domain, e.g. claim@skytek.id.
EMAIL_FROM=
# Local Node only; local Compose uses its Mailpit service. Unused in live mode.
MAILPIT_URL=http://127.0.0.1:8025

# Optional PUBLIC analytics identifiers, never private API secrets.
# Examples: GA4_MEASUREMENT_ID=G-XXXXXXXXXX; GROVS_API_KEY=<public-web-sdk-key>
# Leave empty to keep remote providers disabled; local reporting still works.
GA4_MEASUREMENT_ID=
GROVS_API_KEY=
GROVS_TEST_ENVIRONMENT=false
# Shows the local event inspector on the form.
ANALYTICS_DEBUG=false
PORT=4173
# Node bind address; both Compose files use 0.0.0.0 inside the app container.
HOST=127.0.0.1
# Node only; Compose persists events in its named analytics-data volume.
DATA_DIR=./data

# Local testing: replace the corresponding values above (do not uncomment duplicates).
# APP_MODE=local
# PUBLIC_ORIGIN=http://localhost:4173
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# GROVS_TEST_ENVIRONMENT=true
# ANALYTICS_DEBUG=true
# CLAIM_SECRET and Kirim.Email credentials may be empty in local mode.
# Local email goes to Mailpit at http://localhost:8025.
# Import demo rewards: npm run import:codes -- --demo
# Docker: docker compose exec app npm run import:codes -- --demo
